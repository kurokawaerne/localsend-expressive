<?xml version="1.0" encoding="utf-8"?>
<!-- Splash motion (v0.12.0, Ernest): the radar logo SPINS one full
     turn while it BOUNCES in — rotation eases out over 900 ms, the
     scale runs 0.45 -> 1.0 on the stock overshoot curve, both around
     the group's center pivot. Group alpha is NOT animated (AVD
     groups don't support it). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">
    <objectAnimator
        android:duration="900"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:propertyName="rotation"
        android:valueFrom="0"
        android:valueTo="360"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="900"
        android:interpolator="@android:interpolator/overshoot"
        android:propertyName="scaleX"
        android:valueFrom="0.45"
        android:valueTo="1.0"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="900"
        android:interpolator="@android:interpolator/overshoot"
        android:propertyName="scaleY"
        android:valueFrom="0.45"
        android:valueTo="1.0"
        android:valueType="floatType" />
</set>
