        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.55"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M54,4 A50,50 0 1 1 12.9,83.5" />
    <group
        android:name="plane"
        android:pivotX="54"
        android:pivotY="54"
        android:translateX="15"
        android:translateY="15"
        android:scaleX="3.25"
        android:scaleY="3.25">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M2.01,21L23,12L2.01,3L2,10l15,2L2,14z" />
