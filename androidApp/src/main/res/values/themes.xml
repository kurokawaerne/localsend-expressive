<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme the Compose UI runs under (splash hands over to this). -->
    <style name="Theme.LocalSendExpressive" parent="android:Theme.Material.NoActionBar" />

    <!-- System splash via core-splashscreen: the static arrows mark on a
         light/dark-adaptive background (values / values-night), then the
         app theme and the in-app animated splash. The animated-vector
         variant was dropped in v0.9.0 — one less thing that can fail
         while the splash is up. -->
    <style name="Theme.LocalSendExpressive.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">650</item>
        <item name="postSplashScreenTheme">@style/Theme.LocalSendExpressive</item>
    </style>
</resources>
