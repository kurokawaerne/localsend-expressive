<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App theme the Compose UI runs under (splash hands over to this). -->
    <style name="Theme.LocalSendExpressive" parent="android:Theme.Material.NoActionBar" />

    <!-- THE splash: core-splashscreen, ONE splash on Android.
         v0.12.0 (Ernest): the icon is the current app logo (the
         gradient radar mark) and it spins + bounces in; before that
         it was the v0.8.0 arrows mark with a scale settle. Colors:
         static light/dark below API 31; on API 31+ the background
         follows the system dynamic palette (values-v31), keeping
         the dynamic theme colors Ernest asked for. -->
    <style name="Theme.LocalSendExpressive.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <!-- The branding image (wordmark) is API 31+ platform-only:
             core-splashscreen declares no compat attr for it, so it
             lives in values-v31/themes.xml on the android: attr. -->
        <item name="postSplashScreenTheme">@style/Theme.LocalSendExpressive</item>
    </style>
</resources>
